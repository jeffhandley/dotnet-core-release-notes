: false,\\n      \\\"local_repo_commit\\\": \\\"runtime@5e73c91\\\",\\n      \\\"score\\\": 9,\\n      \\\"score_reason\\\": \\\"Post-quantum cryptography (ML-KEM/CRYSTALS-Kyber) moves from [Experimental] to stable. Anyone building TLS or key-exchange needs this.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@e1c92d3\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"Enable GC regions on macOS\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125416\\\",\\n      \\\"commit\\\": \\\"dotnet@4c9f449\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@e1c92d3\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"GC regions reduce memory fragmentation and improve GC pause predictability on macOS, an increasingly important .NET platform.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@3e90285\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"Add System.Text.Json support for F# discriminated unions\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125610\\\",\\n      \\\"commit\\\": \\\"dotnet@4c9f449\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@3e90285\\\",\\n      \\\"score\\\": 8,\\n      \\\"score_reason\\\": \\\"First-class JSON serialization for F# discriminated unions removes a major friction point for F# developers.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@b5e09e4\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"Add JsonNamingPolicy.PascalCase and JsonKnownNamingPolicy.PascalCase\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124644\\\",\\n      \\\"commit\\\": \\\"dotnet@4c9f449\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@b5e09e4\\\",\\n      \\