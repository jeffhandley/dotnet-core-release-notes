mory efficiency and reduce fragmentation on macOS; most users won't configure it but benefit from lower heap overhead.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@d2b9f04\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"Add JsonNamingPolicy.PascalCase\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124644\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@d2b9f04\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Completes the naming policy set (camelCase, snake_case, now PascalCase). Commonly needed when serializing C# types that should keep PascalCase JSON property names.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@e3c0a15\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"Add JsonNamingPolicyAttribute for member-level naming policies\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124645\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@e3c0a15\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Enables per-member JSON naming overrides without a custom converter. Useful when a type mixes naming conventions.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@f4d1b26\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"Add type-level [JsonIgnore] with JsonIgnoreCondition\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124646\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@f4d1b26\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Allows a type to declare its own conditional ignore behavior, reducing per-property boilerplate for