afe Evolution language feature. Primarily relevant to framework authors.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@e1c8a93\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"Add OverloadResolutionPriority to MemoryMarshal overloads\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/126252\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@e1c8a93\\\",\\n      \\\"score\\\": 3,\\n      \\\"score_reason\\\": \\\"Internal API hygiene for MemoryMarshal. Affects overload disambiguation but rarely impacts end users.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@f2d9b04\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"JIT: Constant fold Span.SequenceEqual for known values\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/issues/125800\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@f2d9b04\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Micro-optimization that benefits hot paths comparing byte spans. Noticeable in tight loops but transparent to application code.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@a3e0c15\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"JIT: Improve Dictionary.Remove performance via inlining\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/issues/126100\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@a3e0c15\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Dictionary.Remove is common enough that inlining it provides broad application-level gains.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"runtime@b4f1d26\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"product\\\": \\\"dotnet-runtime\\\",\\n      \\\"title\\\": \\\"JIT: Eliminate bounds checks in HashSet.Contains\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/issues/125900\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"runtime@b4f1d26\\\",\\n      \\\"score\\\": 4,\\n      \\\"score_reason\\\": \\\"Removes redundant bounds checks in HashSet, giving a small throughput boost for lookup-heavy code.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"aspnetcore@c5e2a37\\\",\\n      \\\"repo\\\": \\\"aspnetcore\\\",\\n      \\\"product\\\": \\\"dotnet-aspnetcore\\\",\\n      \\\"title\\\": \\\"Add Zstandard (zstd) response compression support\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/aspnetcore/pull/65479\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"aspnetcore@c5e2a37\\\",\\n      \\\"score\\\": 9,\\n      \\\"score_reason\\\": \\\"zstd typically outperforms gzip and Brotli at similar CPU budgets. Any production API or web app with compression enabled benefits immediately.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"aspnetcore@d6f3b48\\\",\\n      \\\"repo\\\": \\\"aspnetcore\\\",\\n      \\\"product\\\": \\\"dotnet-aspnetcore\\\",\\n      \\\"title\\\": \\\"Improve HTTP/3 connection startup latency\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/aspnetcore/pull/65399\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"aspnetcore@d6f3b48\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Reduces cold-start penalty for HTTP/3. Useful for services with many short-lived HTTP/3 connections.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"aspnetcore@e7a4c59\\\",\\n      \\\"repo\\\": \\\"aspnetcore\\\",\\n      \\\"product\\\": \\\"dotnet-aspnetcore\\\",\\n      \\\"title\\\": \\\"Add OpenBSD RID support\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/aspnetcore/pull/65628\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"aspnetcore@e7a4c59\\\",\\n      \\\"score\\\": 3,\\n      \\\"score_reason\\\": \\\"Platform support addition for a niche OS. Important for that audience but not broadly applicable.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@f8b5d60\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Support Cosmos complex properties in queries\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37577\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@f8b5d60\\\",\\n      \\\"score\\\": 8,\\n      \\\"score_reason\\\": \\\"Cosmos DB users can now use complex properties in LINQ queries. Previously, complex properties were only supported in model building, not queries — a significant gap.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@a9c6e71\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Support Cosmos complex properties in model building\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37919\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@a9c6e71\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Extends Cosmos complex property support to model configuration. Companion to the query support PR.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@b0d7f82\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Add ChangeTracker.GetEntriesForState()\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37847\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@b0d7f82\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Makes it straightforward to inspect the change tracker for entities in a specific state. Common need when validating before SaveChanges.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@c1e8a93\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Add parameterless AddPooledDbContextFactory overload\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37144\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@c1e8a93\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Reduces ceremony for pooled DbContext registration when configuration is already present in DI.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@d2f9b04\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Support partial property loading in relational queries\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37857\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@d2f9b04\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Allows querying only selected scalar properties of a navigation without a full Include. Useful for performance-sensitive read paths.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@e3a0c15\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Add RemoveExtension and RemoveDbContext APIs\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37891\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@e3a0c15\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Useful when reconfiguring a DbContext builder in tests or multi-tenant scenarios. Narrow but fills a real gap.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@f4b1d26\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Allow excluding foreign keys from migrations\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37815\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@f4b1d26\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Useful when FK constraints are managed externally (read replicas, legacy schemas). Removes the need for custom migration operations.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@a5e2c37\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Generate better SQL for optional one-to-one joins\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37819\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@a5e2c37\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Eliminates redundant outer joins in common navigation property scenarios, reducing query cost transparently.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@b6f3d48\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Record migration ID in model snapshot\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37689\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@b6f3d48\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Improves migration tooling diagnostics. Useful for tracking which migration produced the current snapshot.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"efcore@c7a4e59\\\",\\n      \\\"repo\\\": \\\"efcore\\\",\\n      \\\"product\\\": \\\"dotnet-efcore\\\",\\n      \\\"title\\\": \\\"Add EF.Functions.JsonContains for SQL Server 2025\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/efcore/pull/37714\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"efcore@c7a4e59\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"JSON querying in SQL Server 2025 made available through familiar EF LINQ syntax.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"roslyn@d8b5f60\\\",\\n      \\\"repo\\\": \\\"roslyn\\\",\\n      \\\"product\\\": \\\"dotnet-csharp\\\",\\n      \\\"title\\\": \\\"Unsafe Evolution: emit LangVersion errors for memory safety violations\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/roslyn/pull/82687\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"roslyn@d8b5f60\\\",\\n      \\\"score\\\": 8,\\n      \\\"score_reason\\\": \\\"Key milestone in the Unsafe Evolution feature: the compiler now enforces memory safety rules based on LangVersion. Breaking change for code that was previously allowed.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"roslyn@e9c6a71\\\",\\n      \\\"repo\\\": \\\"roslyn\\\",\\n      \\\"product\\\": \\\"dotnet-csharp\\\",\\n      \\\"title\\\": \\\"Add sequence point emission for custom awaiters in runtime async\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/roslyn/pull/82605\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"roslyn@e9c6a71\\\",\\n      \\\"score\\\": 4,\\n      \\\"score_reason\\\": \\\"Debugger support detail for runtime async. Important for completeness but transparent to most users.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"fsharp@f0d7b82\\\",\\n      \\\"repo\\\": \\\"fsharp\\\",\\n      \\\"product\\\": \\\"dotnet-fsharp\\\",\\n      \\\"title\\\": \\\"Add #version;; directive in F# Interactive\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/fsharp/pull/19332\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"fsharp@f0d7b82\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"F# script authors can now query the F# version at script load time. Useful for version-conditional scripting without launching a separate process.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"fsharp@a1e8c93\\\",\\n      \\\"repo\\\": \\\"fsharp\\\",\\n      \\\"product\\\": \\\"dotnet-fsharp\\\",\\n      \\\"title\\\": \\\"Warn when function type is passed to interpolated string handler\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/fsharp/pull/19289\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"fsharp@a1e8c93\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Catches a common mistake where forgetting () leads to the function itself being embedded in a string. Good usability improvement.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"fsharp@b2f9d04\\\",\\n      \\\"repo\\\": \\\"fsharp\\\",\\n      \\\"product\\\": \\\"dotnet-fsharp\\\",\\n      \\\"title\\\": \\\"Add FSharpType predefined type check methods\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/fsharp/pull/19325\\\",\\n      \\\"commit\\\": \\\"\\\",\\n      \\\"is_security\\\": false,\\n      \\\"local_repo_commit\\\": \\\"fsharp@b2f9d04\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Reflection API improvement for F# tooling and metaprogramming. Mainly relevant to library authors.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"fsharp@c3a0e15\\\",\\n      \\\"repo\\\": \\\"fsharp\\\",\\n      \\\"product\\\": \\\"dotnet-fsharp\\\",\\n      \\\"title\\\": \\\"Cache compiler attributes for improved performance\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/fsharp/pull/19394\\\",\\n      \\\"commit\\\": \\\"\\\",\\n   