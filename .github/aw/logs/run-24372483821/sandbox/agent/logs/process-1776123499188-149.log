            "function": {
              "name": "create",
              "arguments": "{\"file_text\": \"{\\n  \\\"release-version\\\": \\\"11.0.0-preview.3\\\",\\n  \\\"base\\\": \\\"v11.0.0-preview.2.26159.112\\\",\\n  \\\"head\\\": \\\"origin/release/11.0.1xx-preview3\\\",\\n  \\\"changes\\\": [\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/126343\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Enable runtime-async for shared framework source projects in net11.0+\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/126343\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 9,\\n      \\\"score_reason\\\": \\\"Runtime-async becomes the default compilation model for net11.0 targets — every developer targeting .NET 11 gets this automatically; immediate visible value in performance and stack traces.\\\",\\n      \\\"section\\\": \\\"Runtime Async enabled by default for .NET 11\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124488\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"[RuntimeAsync] Remove [RequiresPreviewFeatures] on runtime async API\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124488\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Removing the preview gate signals that the runtime-async API surface is stable; developers can use it without opting into preview features.\\\",\\n      \\\"section\\\": \\\"Runtime Async enabled by default for .NET 11\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/125556\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Add runtime async support for saving and reusing continuation instances\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125556\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Continuation reuse reduces allocations in hot async paths; pairs with the JIT optimization to make runtime-async more efficient.\\\",\\n      \\\"section\\\": \\\"Runtime Async performance improvements\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/125615\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"JIT: Add a runtime async optimization to skip saving unmutated locals into reused continuations\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125615\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Reduces state saved per async suspension, improving throughput in hot async loops.\\\",\\n      \\\"section\\\": \\\"Runtime Async performance improvements\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/125416\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Enable GC regions on macOS\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125416\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"GC regions improve heap management and can reduce memory footprint on macOS; previously regions were disabled on Apple platforms. Meaningful improvement for server and desktop apps running on macOS.\\\",\\n      \\\"section\\\": \\\"GC regions enabled on macOS\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124504\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Arm64: Add SM4 and SHA3 instructions\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124504\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Hardware-accelerated SM4 and SHA3 on ARM64 targets; useful for cryptography code on Apple Silicon and ARM servers. Niche audience but clear value when relevant.\\\",\\n      \\\"section\\\": \\\"ARM64 SM4 and SHA3 hardware intrinsics\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124332\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"arm64: Fold negative variable eq/ne to 0\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124332\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 3,\\n      \\\"score_reason\\\": \\\"ARM64 JIT micro-optimization; user-invisible unless running benchmarks.\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124567\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"JIT: Convert multi-target switches to branchless checks\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124567\\\",\\n      \\\"product\\\": \\\"runtime\\\",\\n      \\\"score\\\": 3,\\n      \\\"score_reason\\\": \\\"JIT codegen improvement for switch statements; user-invisible.\\\",\\n      \\\"component\\\": \\\"runtime\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/125893\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Improve HashSet<T> performance by enabling JIT bounds check elimination\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125893\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"HashSet is used everywhere; bounds-check elimination is a JIT win the reader sees passively but appreciates.\\\",\\n      \\\"section\\\": \\\"HashSet<T> performance\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124644\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Add JsonNamingPolicy.PascalCase and JsonKnownNamingPolicy.PascalCase\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124644\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 8,\\n      \\\"score_reason\\\": \\\"PascalCase naming is the .NET default and commonly needed when serializing to JavaScript SDKs that expect PascalCase. Rounds out the naming policy story.\\\",\\n      \\\"section\\\": \\\"System.Text.Json naming and serialization improvements\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124645\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Add JsonNamingPolicyAttribute for member-level naming policies in System.Text.Json\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124645\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 8,\\n      \\\"score_reason\\\": \\\"Allows per-member naming policy without requiring a class-wide policy; common pattern for mixed serialization contracts.\\\",\\n      \\\"section\\\": \\\"System.Text.Json naming and serialization improvements\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124646\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Support type-level JsonIgnoreCondition via [JsonIgnore] on classes, structs, and interfaces\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124646\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Reduces boilerplate by applying ignore conditions at the type level; common ask for DTO patterns.\\\",\\n      \\\"section\\\": \\\"System.Text.Json naming and serialization improvements\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/123209\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Support generic converters on generic types with JsonConverterAttribute\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/123209\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Long-requested capability; makes attribute-based converter registration work for generic types in the same way it works for concrete types.\\\",\\n      \\\"section\\\": \\\"System.Text.Json naming and serialization improvements\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/122950\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Support constructors with byref parameters (in/ref/out) in System.Text.Json\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/122950\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Enables deserialization into types with ref-parameter constructors; niche but breaks an otherwise confusing limitation.\\\",\\n      \\\"section\\\": \\\"System.Text.Json naming and serialization improvements\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/ml-kem-stabilize\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Stabilize ML-KEM APIs and remove Experimental attribute\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/issues/124780\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 8,\\n      \\\"score_reason\\\": \\\"ML-KEM (post-quantum key encapsulation) graduating from Experimental to stable API is a security milestone; developers can now take a production dependency on it.\\\",\\n      \\\"section\\\": \\\"ML-KEM API stabilization\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/crc-parameterized\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Add parameterized CRC-32 and CRC-64\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124441\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Parameterized CRC lets developers compute CRCs matching many protocol or file-format variants; previously required a third-party library.\\\",\\n      \\\"section\\\": \\\"Parameterized CRC algorithms\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124634\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Move Zstandard APIs from System.IO.Compression.Zstandard to System.IO.Compression\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124634\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Moving to the main compression namespace makes ZstandardStream discoverable alongside GZipStream and BrotliStream; completion of the Zstandard integration story.\\\",\\n      \\\"section\\\": \\\"Zstandard moved to System.IO.Compression\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/124766\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Add CRC32 validation when reading zip archive entries\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/124766\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 7,\\n      \\\"score_reason\\\": \\\"Adds integrity checking that was missing from zip reads; important for security-sensitive applications that extract untrusted archives.\\\",\\n      \\\"section\\\": \\\"ZIP integrity: CRC32 validation\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/125512\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Relax RandomAccess type requirements: make Read/Write methods work with non-seekable files\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125512\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"Removes an unnecessary constraint; lets developers use RandomAccess with pipes and streams that don't support seeking.\\\",\\n      \\\"section\\\": \\\"RandomAccess works with non-seekable streams\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/123076\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Handle RFC 6761 special-use domain names in Dns resolution\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/123076\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 6,\\n      \\\"score_reason\\\": \\\"RFC 6761 names like .local, .localhost, .test should not be sent to public DNS; this matches browser/OS behavior and prevents information leaks.\\\",\\n      \\\"section\\\": \\\"DNS resolution honors RFC 6761 special-use domains\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/125289\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Improve regex optimizer through investigation of regex optimizer passes\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125289\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Regex optimization pass improvements reduce pattern compilation time; affects all regex users passively.\\\",\\n      \\\"section\\\": \\\"Regex performance improvements\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/125636\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Reduce backtracking for greedy loops followed by subsumed literals\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/125636\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Reduces worst-case regex backtracking for common patterns; passive win for developers using greedy quantifiers.\\\",\\n      \\\"section\\\": \\\"Regex performance improvements\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/126076\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Allow null arguments in ProcessStartInfo constructor and Process.Start\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/126076\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Removes a nullable gotcha when constructing ProcessStartInfo; common source of NullReferenceException in process-launching code.\\\",\\n      \\\"section\\\": \\\"Process.Start accepts null arguments\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/runtime/126052\\\",\\n      \\\"repo\\\": \\\"runtime\\\",\\n      \\\"title\\\": \\\"Add VectorXx.Asin and use it to vectorize TensorPrimitives.Asin\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/runtime/pull/126052\\\",\\n      \\\"product\\\": \\\"libraries\\\",\\n      \\\"score\\\": 5,\\n      \\\"score_reason\\\": \\\"Vectorized trig functions benefit ML workloads using TensorPrimitives; niche but useful for AI/numeric scenarios.\\\",\\n      \\\"section\\\": \\\"Numerics: vectorized Asin for TensorPrimitives\\\",\\n      \\\"component\\\": \\\"libraries\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dotnet/aspnetcore/65415\\\",\\n      \\\"repo\\\": \\\"aspnetcore\\\",\\n      \\\"title\\\": \\\"Add support for OpenAPI 3.2.0\\\",\\n      \\\"url\\\": \\\"https://github.com/dotnet/aspnetcore/pull/65415\\\",\\n      \\\"product\\\": \\\"aspnetcore\\\",\\n      \\\"score\\\": 8,\\n      \\\"score_reason\\\": \\\"OpenAPI 3.2 aligns with the latest spec and improves compatibility with OpenAPI tooling; developers using Minimal APIs get richer schema output.\\\",\\n      \\\"section\\\": \\\"OpenAPI 3.2 support\\\",\\n      \\\"component\\\