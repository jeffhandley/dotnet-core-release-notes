 = subprocess.run(\\n                [\\\"git\\\", \\\"fetch\\\", \\\"--depth=1000\\\", \\\"origin\\\", branch],\\n                cwd=tmpdir,\\n                capture_output=True,\\n                text=True,\\n                timeout=60\\n            )\\n            \\n            if result.returncode == 0:\\n                # Get the log\\n                log_result = subprocess.run(\\n                    [\\\"git\\\", \\\"log\\\", \\\"--format=%H|||%s\\\", f\\\"{base_sha}..{head_sha}\\\"],\\n                    cwd=tmpdir,\\n                    capture_output=True,\\n                    text=True,\\n                    timeout=10\\n                )\\n                \\n                if log_result.returncode == 0:\\n                    lines = log_result.stdout.strip().split('\\\\n')\\n                    print(f\\\"Found {len([l for l in lines if l])} commits\\\")\\n                    \\n                    for line in lines:\\n                        if not line:\\n                            continue\\n                        \\n                        parts = line.split('|||', 1)\\n                        if len(parts) == 2:\\n                            commit_hash = parts[0]\\n                            title = parts[1]\\n                            \\n                            # Skip certain patterns\\n                            if any(skip in title for skip in [\\\"Merge \\\", \\\"Update dep\\\", \\\"[automated]\\\", \\\"Version \\\", \\\"Bump \\\"]):\\n                                continue\\n                            \\n                            # Extract PR number\\n                            pr_match = re.search(r'\\\\(#(\\\\d+)\\\\)$', title)\\n                            if pr_match:\\n                                pr_num = int(pr_match.group(1))\\n                                pr_url = f\\\"https://github.com/{org}/{repo_name.replace('.', '/')}/pull/{pr_num}\\\"\\n                                pr_list.append({\\n              